---
import manifestData from '../../../games-manifest.json';
import type { Manifest, Game } from '../../../types/manifest';

const manifest = manifestData as Manifest;

export function getStaticPaths() {
  const m = manifestData as Manifest;
  return m.games.map((game: Game) => ({
    params: { day: game.day.toString(), slug: game.slug },
  }));
}

const { day, slug } = Astro.params;
const dayNumber = parseInt(day || '1');

const game = manifest.games.find((g: Game) => g.slug === slug);
const gameTitle = game?.title || 'Game';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{gameTitle} - Advent of Games</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html, body {
        height: 100%;
        overflow: hidden;
        background: linear-gradient(to bottom, #111827, #000000);
        font-family: 'Share Tech Mono', monospace;
      }
      .header {
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1rem;
        background: rgba(0, 0, 0, 0.8);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }
      .title {
        font-family: 'Press Start 2P', cursive;
        font-size: 1rem;
        background: linear-gradient(to right, #4ade80, #22d3ee);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .back-link {
        font-family: 'Press Start 2P', cursive;
        font-size: 0.625rem;
        color: white;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border: 2px solid rgba(255, 255, 255, 0.3);
        background: rgba(255, 255, 255, 0.1);
        transition: all 0.2s;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }
      .back-link:hover {
        border-color: white;
        background: rgba(255, 255, 255, 0.2);
      }
      .game-container {
        height: calc(100% - 60px);
        width: 100%;
      }
      iframe {
        width: 100%;
        height: 100%;
        border: none;
      }
    </style>
  </head>
  <body>
    <header class="header">
      <h1 class="title">{gameTitle}</h1>
      <a href="/" class="back-link">← Back</a>
    </header>
    <div class="game-container">
      <iframe
        src={`/games/day-${dayNumber}/index.html`}
        title={gameTitle}
      ></iframe>
    </div>
  </body>
</html>

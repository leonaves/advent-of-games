---
import Layout from '../layouts/Layout.astro';
import manifest from '../games-manifest.json';

const year = manifest.year;
---

<Layout title="Advent of Games">
  <main class="container relative z-10 mx-auto px-4 py-12">
    <header class="relative mb-12 text-center">
      <div
        class="bg-neon-blue/20 pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[200px] w-[90vw] max-w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full blur-[100px]"
      >
      </div>
      <h1
        class="font-display to-neon-blue mb-6 bg-gradient-to-b from-white bg-clip-text text-3xl uppercase leading-relaxed tracking-widest text-transparent drop-shadow-[0_0_15px_rgba(0,243,255,0.6)] md:text-5xl"
      >
        Advent of Games
      </h1>
    </header>

    <div class="mx-auto max-w-6xl">
      <div class="grid grid-cols-5 gap-2 md:gap-4" id="games-container">
        <!-- Games will be rendered here by client-side JS -->
      </div>
    </div>

    <!-- Modal -->
    <div
      id="game-modal"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm"
    >
      <div class="relative w-full max-w-2xl">
        <div
          class="from-neon-blue to-neon-pink absolute -inset-[4px] bg-gradient-to-r opacity-60 blur-sm"
        >
        </div>
        <div class="relative border-2 border-white/20 bg-black/95 backdrop-blur-xl">
          <div class="p-6 md:p-8">
            <div class="mb-6 flex items-start justify-between">
              <div>
                <div class="font-display text-neon-blue mb-2 text-xs" id="modal-date"></div>
                <h2 class="font-display mb-2 text-2xl text-white md:text-3xl" id="modal-title"></h2>
              </div>
              <button
                id="close-modal"
                class="text-2xl leading-none text-white/60 transition-colors hover:text-white"
                >×</button
              >
            </div>

            <div class="mb-6">
              <img
                id="modal-thumbnail"
                src=""
                alt=""
                class="aspect-square w-full border-2 border-white/10 object-cover"
              />
            </div>

            <p
              class="mb-8 text-base leading-relaxed text-blue-100/80 md:text-lg"
              id="modal-description"
            >
            </p>

            <a
              id="modal-play-btn"
              href=""
              class="font-display hover:bg-neon-blue block w-full border-2 border-transparent bg-white px-6 py-4 text-center text-sm uppercase tracking-widest text-black shadow-[4px_4px_0px_rgba(0,243,255,0.4)] transition-all hover:-translate-y-1 hover:border-black hover:shadow-[6px_6px_0px_rgba(0,243,255,0.6)]"
            >
              Play Game
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script define:vars={{ manifest, year }}>
    function getCurrentDay() {
      const now = new Date();
      const currentYear = now.getFullYear();
      const currentMonth = now.getMonth() + 1;
      const currentDate = now.getDate();

      if (currentYear === year && currentMonth === 12) {
        return Math.min(currentDate, 25);
      }

      if (currentYear > year || (currentYear === year && currentMonth > 12)) {
        return 25;
      }

      return 0;
    }

    function getTimeUntilUnlock(day) {
      const unlockDate = new Date(`${year}-12-${String(day).padStart(2, '0')}T00:00:00`);
      const now = new Date();
      const diff = unlockDate - now;

      if (diff <= 0) return null;

      const hours = Math.floor(diff / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      return { hours, minutes, seconds, total: diff };
    }

    function formatDate(day) {
      const date = new Date(`${year}-12-${String(day).padStart(2, '0')}`);
      return date.toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
      });
    }

    function renderGames() {
      const container = document.getElementById('games-container');
      if (!container) return;

      const currentDay = getCurrentDay();
      const gamesByDay = {};

      manifest.games.forEach((game) => {
        gamesByDay[game.day] = game;
      });

      let html = '';

      for (let day = 1; day <= 25; day++) {
        const game = gamesByDay[day];
        const dateStr = formatDate(day);
        const isUnlocked = day <= currentDay;
        const isNextDay = day === currentDay + 1;

        if (game && isUnlocked) {
          // Unlocked game with thumbnail
          html += `
            <button data-game='${JSON.stringify({ ...game, dateStr })}' class="game-tile group relative aspect-square block overflow-hidden border-2 border-white/20 bg-black/90 transition-all hover:border-neon-blue hover:scale-105 w-full">
              <div class="from-neon-blue to-neon-pink absolute -inset-[2px] bg-gradient-to-br opacity-0 blur-sm transition-opacity duration-300 group-hover:opacity-100"></div>
              <div class="relative h-full w-full overflow-hidden">
                <img src="${game.thumbnail}" alt="${game.title}" class="h-full w-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-1 md:p-2">
                  <div class="font-display text-[0.5rem] md:text-xs text-neon-blue mb-0.5 truncate">${dateStr}</div>
                  <div class="font-display text-[0.6rem] md:text-sm text-white leading-tight truncate">${game.title}</div>
                </div>
              </div>
            </button>
          `;
        } else if (isNextDay) {
          // Next day with countdown
          const timeUntil = getTimeUntilUnlock(day);
          if (timeUntil) {
            html += `
              <div class="relative aspect-square overflow-hidden border-2 border-purple-500/30 bg-black/90">
                <div class="from-neon-purple to-neon-pink absolute -inset-[2px] animate-pulse bg-gradient-to-br opacity-30 blur-sm"></div>
                <div class="relative flex h-full w-full flex-col items-center justify-center p-1">
                  <div class="font-display text-[0.5rem] md:text-xs text-purple-300/60 mb-0.5 md:mb-1 truncate w-full text-center">${dateStr}</div>
                  <div class="text-base md:text-2xl mb-1 md:mb-2">🎮</div>
                  <div class="font-display text-[0.5rem] md:text-xs text-neon-purple" id="countdown-${day}">
                    ${String(timeUntil.hours).padStart(2, '0')}:${String(timeUntil.minutes).padStart(2, '0')}:${String(timeUntil.seconds).padStart(2, '0')}
                  </div>
                </div>
              </div>
            `;
          }
        } else if (!isUnlocked) {
          // Locked future day
          html += `
            <div class="relative aspect-square overflow-hidden border-2 border-white/10 bg-black/80 opacity-60">
              <div class="relative flex h-full w-full flex-col items-center justify-center p-1">
                <div class="font-display text-[0.5rem] md:text-xs text-blue-300/40 mb-0.5 md:mb-1 truncate w-full text-center">${dateStr}</div>
                <div class="text-base md:text-2xl opacity-30">🔒</div>
              </div>
            </div>
          `;
        } else {
          // Unlocked day but no game yet
          html += `
            <div class="relative aspect-square overflow-hidden border-2 border-white/10 bg-black/80 opacity-60">
              <div class="relative flex h-full w-full flex-col items-center justify-center p-1">
                <div class="font-display text-[0.5rem] md:text-xs text-blue-300/40 mb-0.5 md:mb-1 truncate w-full text-center">${dateStr}</div>
                <div class="text-base md:text-2xl">⏳</div>
              </div>
            </div>
          `;
        }
      }

      container.innerHTML = html;

      // Setup countdown for next day only
      if (currentDay < 25) {
        const nextDay = currentDay + 1;
        const countdownEl = document.getElementById(`countdown-${nextDay}`);

        if (countdownEl) {
          setInterval(() => {
            const timeUntil = getTimeUntilUnlock(nextDay);
            if (timeUntil) {
              countdownEl.textContent = `${String(timeUntil.hours).padStart(2, '0')}:${String(timeUntil.minutes).padStart(2, '0')}:${String(timeUntil.seconds).padStart(2, '0')}`;
            } else {
              window.location.reload();
            }
          }, 1000);
        }
      }

      // Setup modal event listeners
      setupModalListeners();
    }

    function setupModalListeners() {
      const modal = document.getElementById('game-modal');
      const closeBtn = document.getElementById('close-modal');
      const gameTiles = document.querySelectorAll('.game-tile');

      gameTiles.forEach((tile) => {
        tile.addEventListener('click', () => {
          const gameData = JSON.parse(tile.getAttribute('data-game'));
          openModal(gameData);
        });
      });

      closeBtn?.addEventListener('click', closeModal);
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    function openModal(game) {
      const modal = document.getElementById('game-modal');
      const modalDate = document.getElementById('modal-date');
      const modalTitle = document.getElementById('modal-title');
      const modalThumbnail = document.getElementById('modal-thumbnail');
      const modalDescription = document.getElementById('modal-description');
      const modalPlayBtn = document.getElementById('modal-play-btn');

      if (modalDate) modalDate.textContent = game.dateStr;
      if (modalTitle) modalTitle.textContent = game.title;
      if (modalThumbnail) {
        modalThumbnail.src = game.thumbnail;
        modalThumbnail.alt = game.title;
      }
      if (modalDescription) modalDescription.textContent = game.description;
      if (modalPlayBtn) modalPlayBtn.href = `/day/${game.day}/${game.slug}`;

      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }

    function closeModal() {
      const modal = document.getElementById('game-modal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    // Handle ESC key to close modal
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    renderGames();
    setInterval(renderGames, 60000);
  </script>
</Layout>
